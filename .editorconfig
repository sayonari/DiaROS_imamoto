# EditorConfig is awesome: https://EditorConfig.org

# トップレベルのEditorConfigファイル
root = true

# すべてのファイルのデフォルト設定
[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# シェルスクリプト
[*.{sh,bash}]
end_of_line = lf
indent_size = 2

# Pythonファイル
[*.py]
end_of_line = lf
indent_size = 4

# YAMLファイル
[*.{yml,yaml}]
end_of_line = lf
indent_size = 2

# JSONファイル
[*.json]
end_of_line = lf
indent_size = 2

# Markdownファイル
[*.md]
end_of_line = lf
trim_trailing_whitespace = false

# Makefile
[Makefile]
indent_style = tab

# Dockerファイル
[Dockerfile]
end_of_line = lf
indent_size = 4